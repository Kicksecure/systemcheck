canary_config_folders=(/etc/systemcheck.d /usr/local/etc/systemcheck.d /usr/local/etc/whonix.d /etc/whonix.d)

if grep -r --quiet '^whonixcheck_skip_functions+=" download_whonix_news "' -- "${canary_config_folders[@]}" 2>/dev/null ; then
    true "INFO: Legacy disabled in settings. Doing nothing. Exiting."
    canary_run=false
fi

if grep -r --quiet '^systemcheck_skip_functions+=" download_whonix_news "' -- "${canary_config_folders[@]}" 2>/dev/null ; then
    true "INFO: Legacy disabled in settings. Doing nothing. Exiting."
    canary_run=false
fi

