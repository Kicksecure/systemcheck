## style-ok: no-strict
## Sourced fragment; 'systemcheck' owns the strict-mode preamble.

parse_cmd_options() {
   ## If systemcheck is run without command line arguments,
   ## $1 will not exist.

   ## defaults
   ## adding --silent to curl to suppress output
   CURL_VERBOSE="--silent"

   ## Thanks to:
   ## http://mywiki.wooledge.org/BashFAQ/035

   while :
   do
       case $1 in
           -h | --help | -\?)
               help_cli
               EXIT_CODE="0"
               cleanup
               return 0
               ;;
           -v | --verbose)
               ## The main 'systemcheck' script ensures this is an integer
               ## when we get here.
               verbose="$(( $verbose + 1 ))"
               shift
               ;;
           -e | --debug)
               echo "$SCRIPTNAME debug output..."
               echo "Script running as $(whoami)"
               set -x
               CURL_VERBOSE=""
               shift
               ;;
           -f | --function)
               FUNCTION="$2"
               if [ "$FUNCTION" = "" ]; then
                  FUNCTION="none"
                  shift
               else
                  shift 2
               fi
               ;;
           --skip)
               ## Skip a specific check function (repeatable). Kept in a separate
               ## variable from systemcheck_skip_functions because source_config
               ## (run after this) resets the latter from the config files.
               systemcheck_skip_functions_cli="${systemcheck_skip_functions_cli:-} $2 "
               shift 2
               ;;
           --ignore-failed-unit)
               ## Do not let the named systemd unit fail the units check
               ## (repeatable). For expected, environment-specific failures --
               ## e.g. systemd-modules-load under Secure Boot, where an unsigned
               ## out-of-tree module (tirdad) cannot load.
               systemcheck_ignore_failed_units_cli="${systemcheck_ignore_failed_units_cli:-} $2 "
               shift 2
               ;;
           --journal-ignore-fixed)
               ## Do not let a journal line CONTAINING this FIXED STRING fail
               ## check_journal (repeatable). CLI counterpart of the config-file
               ## 'journal_ignore_fixed_list'; applied on top of it, nothing existing
               ## is weakened. For expected, environment-specific warnings -- e.g.
               ## privleapd skipping a tor action whose 'debian-tor' TargetUser is
               ## absent on a no-tor build. Newline-delimited (may contain spaces).
               systemcheck_journal_ignore_fixed_cli="${systemcheck_journal_ignore_fixed_cli:-}${2}"$'\n'
               shift 2
               ;;
           --journal-ignore-match)
               ## As --journal-ignore-fixed, but the argument is an EXTENDED REGEXP.
               ## CLI counterpart of the config-file 'journal_ignore_patterns_list'.
               systemcheck_journal_ignore_match_cli="${systemcheck_journal_ignore_match_cli:-}${2}"$'\n'
               shift 2
               ;;
           --mode)
               MODE="$2"
               shift 2
               ;;
           -m | --minimal)
               MINIMAL="1"
               shift
               ;;
           --pin-tpo-cert)
               PIN_TPO_CERT="true"
               shift
               ;;
           --no-pin-tpo-cert)
               PIN_TPO_CERT="false"
               shift
               ;;
           --no-del-tmp)
               DEL_TMP="false"
               shift
               ;;
           --gui)
               GUI="true"
               shift
               ;;
           --cli)
               CLI="true"
               shift
               ;;
           --show-ip)
               show_ip="true"
               shift
               ;;
           --leak-test | --leak-tests | --leaktest | --leaktests | --ip-test | --iptest | --ip-tests | --iptests)
               leak_tests="true"
               shift
               ;;
           --autostart)
               systemcheck_autostart_mode="true"
               shift
               ;;
           --dev)
               dev_mode="true"
               shift
               ;;
           --)
               shift
               break
               ;;
           -*)
               echo "$SCRIPTNAME unknown option: $1" >&2
               EXIT_CODE="1"
               cleanup "1"
               return 0
               ;;
           *)
               break
               ;;
       esac
   done

   ## If there are input files (for example) that follow the options, they
   ## will remain in the "$@" positional parameters.
}
