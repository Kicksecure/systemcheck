## style-ok: no-strict
## Sourced fragment; 'systemcheck' owns the strict-mode preamble.

check_user_sysmaint_split() {
   check_user_sysmaint_split_package
   check_user_sysmaint_split_boot_mode
}

check_user_sysmaint_split_package() {
   local link_sysmaint status_text
   link_sysmaint="https://www.kicksecure.com/wiki/sysmaint"
   status_text="user-sysmaint-split installation check"

   if ! leaprun user-sysmaint-split-check &>/dev/null ; then
      emit_status_line info "$status_text" "$link_sysmaint" orange "Not installed"
      return 0
   fi

   emit_status_line info "$status_text" "$link_sysmaint" green "Installed"
   return 0
}

check_user_sysmaint_split_boot_mode() {
   if ! [ "$booted_in_sysmaint_session" = 'true' ]; then
      MSG="<p>user-sysmaint-split session detection result: USER Session.</p>"
   else
      MSG="<p>user-sysmaint-split session detection result: SYSMAINT Session.</p>"
   fi

   emit_message info "$MSG"
}
